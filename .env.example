# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only

# Google Calendar (OAuth client; scope: calendar.events, access_type=offline)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph / Binus M365 (scope: Calendars.ReadWrite offline_access)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# Advisor report email (Resend) + weekly cron
RESEND_API_KEY=
REPORT_FROM="CompeteSync <laporan@yourdomain.id>"
CRON_SECRET=

# Guidebook reader (free key from https://aistudio.google.com/apikey); server only
GEMINI_API_KEY=
GEMINI_MODEL=              # optional; tried before the built-in fallbacks

# Cloud sync between devices (/api/store): needs the two Supabase values above, plus supabase/schema_cloud_sync.sql
# Without them the app stays local. In local development an in-memory store is used automatically.
